# Copy the matching fields from Firebase Console > Project settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. For development with the Auth emulator, use the computer's LAN IP on a phone.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
